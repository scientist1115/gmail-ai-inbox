:root{
  --paper:#f6f1e6;
  --paper-deep:#efe7d5;
  --ink:#26241f;
  --ink-soft:#5c574c;
  --pine:#1e3b32;
  --pine-light:#2d5346;
  --stamp-red:#b54b3a;
  --stamp-ochre:#c98a3c;
  --stamp-sage:#8b9184;
  --memo-pink:#e7c9d2;
  --memo-ink:#93475f;
  --line:#d9cfb9;
  --font-display:"Fraunces",serif;
  --font-body:"Inter",system-ui,sans-serif;
  --font-mono:"IBM Plex Mono",monospace;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--font-body);
  background-image:
    radial-gradient(circle at 1px 1px, rgba(38,36,31,.035) 1px, transparent 0);
  background-size:22px 22px;
}
.deskline{position:fixed;inset:0 0 auto 0;height:6px;background:var(--pine)}
main{max-width:920px;margin:0 auto;padding:56px 24px 90px}

.sky-banner{
  position:relative;height:64px;border-radius:2px;overflow:hidden;
  margin-bottom:18px;border:1px solid var(--line);
  transition:background 1.2s ease;
}
.sky-banner.dawn{background:linear-gradient(180deg,#f0c48a,var(--paper))}
.sky-banner.day{background:linear-gradient(180deg,#fbeac6,var(--paper))}
.sky-banner.dusk{background:linear-gradient(180deg,#c97a5c,#f0ddc4)}
.sky-banner.night{background:linear-gradient(180deg,#22392f,#1b1a16)}
.sky-banner.night .postmark{color:var(--paper);border-color:var(--paper);background:rgba(255,255,255,.08)}
.celestial{
  position:absolute;font-size:1.3rem;transform:translate(-50%,-50%);
  transition:left 1.2s linear, top 1.2s linear;
  filter:drop-shadow(0 0 4px rgba(255,255,255,.6));
}
.postmark{
  position:absolute;right:14px;top:50%;transform:translateY(-50%);
  border:1.5px dashed var(--ink);border-radius:50%;
  width:62px;height:62px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  font-family:var(--font-mono);color:var(--ink);
  background:rgba(255,255,255,.4);
}
.postmark span{font-size:.6rem;line-height:1.35}

.quote-card{
  border:1px solid var(--line);border-top:none;
  padding:20px 18px 12px;margin:0 0 28px;
  font-family:var(--font-display);font-style:italic;
  background:var(--paper-deep);
}
.quote-flap{width:100%;height:22px;display:block;color:var(--pine);margin-top:-1px}
.quote-text{margin:2px 0 6px;font-size:1rem;color:var(--ink)}
.quote-attr{margin:0;font-family:var(--font-mono);font-style:normal;font-size:.72rem;color:var(--ink-soft)}

header{
  border-bottom:2px solid var(--ink);
  padding-bottom:28px;
  margin-bottom:32px;
}
.eyebrow{
  font-family:var(--font-mono);
  font-size:.72rem;
  letter-spacing:.16em;
  color:var(--pine);
  margin:0 0 10px;
}
h1{
  font-family:var(--font-display);
  font-weight:700;
  font-size:3.4rem;
  line-height:1;
  margin:0 0 14px;
  letter-spacing:-.01em;
  display:flex;align-items:center;gap:14px;
}
.envelope-icon{width:40px;height:auto;color:var(--pine);flex-shrink:0}
.status{
  font-size:.95rem;
  color:var(--ink-soft);
  margin:0 0 22px;
}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.button{
  border:2px solid var(--ink);
  border-radius:2px;
  padding:11px 18px;
  font-family:var(--font-body);
  font-weight:600;
  font-size:.9rem;
  cursor:pointer;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:6px;
  transition:transform .12s ease;
}
.button:active{transform:translateY(1px)}
.button.primary{background:var(--pine);border-color:var(--pine);color:var(--paper)}
.button.primary:hover{background:var(--pine-light)}
.button.ghost{background:transparent;color:var(--ink)}
.button.ghost:hover{background:var(--ink);color:var(--paper)}
.button:disabled{opacity:.55;cursor:not-allowed;transform:none}

.summary{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
  margin-bottom:28px;
}
.summary .seal{
  background:var(--paper-deep);
  border:1px solid var(--line);
  border-radius:3px;
  padding:18px 16px;
  position:relative;
  overflow:hidden;
}
.summary .seal::before{
  content:"";
  position:absolute;
  top:-24px;right:-24px;
  width:64px;height:64px;
  border-radius:50%;
  opacity:.15;
}
.summary .seal.important::before{background:var(--stamp-red)}
.summary .seal.normal::before{background:var(--stamp-ochre)}
.summary .seal.low::before{background:var(--stamp-sage)}
.summary strong{
  font-family:var(--font-display);
  font-size:2.2rem;
  display:block;
  line-height:1;
}
.summary span{
  font-family:var(--font-mono);
  font-size:.72rem;
  letter-spacing:.08em;
  color:var(--ink-soft);
  text-transform:uppercase;
}

.report-panel{
  background:var(--pine);color:var(--paper);border-radius:2px;
  padding:20px 24px;margin-bottom:28px;position:relative;
}
.report-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.report-head h2{font-family:var(--font-display);font-size:1.2rem;margin:0}
.report-head .close{color:var(--paper);opacity:.8}
.report-head .close:hover{opacity:1}
.report-text{margin:0;line-height:1.6;font-size:.92rem;white-space:pre-wrap}

.style-panel{
  background:var(--paper-deep);border:2px solid var(--pine);border-radius:2px;
  padding:20px 24px;margin-bottom:28px;
}
.style-panel .report-head h2{color:var(--pine)}
.style-panel .close{color:var(--ink-soft)}
#styleInput{
  width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:2px;
  font-family:var(--font-body);font-size:.9rem;resize:vertical;background:#fff;
}

.cal-nav{display:flex;align-items:center;justify-content:center;gap:18px;margin-bottom:14px}
.cal-nav h3{font-family:var(--font-display);font-size:1.15rem;margin:0;min-width:120px;text-align:center}
.cal-grid{
  display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:30px;
}
.cal-dow{
  font-family:var(--font-mono);font-size:.68rem;color:var(--ink-soft);
  text-align:center;padding-bottom:6px;letter-spacing:.05em;
}
.cal-cell{
  aspect-ratio:1;border:1px solid var(--line);border-radius:2px;
  background:var(--paper-deep);position:relative;padding:6px;
}
.cal-cell.empty-cell{border-color:transparent;background:transparent}
.cal-daynum{font-family:var(--font-mono);font-size:.78rem;color:var(--ink-soft)}
.cal-cell.today{border-color:var(--pine);border-width:2px}
.cal-cell.today .cal-daynum{color:var(--pine);font-weight:700}
.cal-cell.has-due{cursor:pointer;background:#fff}
.cal-cell.has-due:hover{border-color:var(--stamp-red)}
.cal-dot{
  position:absolute;bottom:6px;right:6px;
  background:var(--stamp-red);color:#fff;
  font-family:var(--font-mono);font-size:.62rem;font-weight:600;
  width:16px;height:16px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
}
@media(max-width:640px){
  .cal-cell{padding:4px}
  .cal-daynum{font-size:.68rem}
}
.tabs{display:flex;gap:2px;flex-wrap:wrap;margin-bottom:22px;border-bottom:1px solid var(--line)}
.vault{display:grid;gap:16px}
.vault-card{
  background:var(--paper-deep);border:1px solid var(--line);border-radius:2px;
  padding:18px 20px;
}
.vault-card.biz{border-color:var(--stamp-red);border-width:2px;background:#fff}
.vault-head h3{font-family:var(--font-display);font-weight:600;font-size:1.1rem;margin:4px 0 2px}
.vault-head .from{font-family:var(--font-mono);font-size:.72rem;color:var(--ink-soft);margin:0 0 10px}
.biz-badge{
  display:inline-block;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.06em;
  color:var(--stamp-red);border:1px solid var(--stamp-red);border-radius:20px;
  padding:2px 10px;margin-bottom:6px;
}
.vault-card .ideas-list{margin-top:0}
.tab{
  background:none;border:0;
  font-family:var(--font-mono);
  font-size:.82rem;
  letter-spacing:.05em;
  padding:10px 4px;
  margin-right:22px;
  color:var(--ink-soft);
  cursor:pointer;
  border-bottom:2px solid transparent;
  position:relative;
  bottom:-1px;
}
.tab.active{color:var(--ink);border-bottom-color:var(--pine)}

.emails{display:grid;gap:12px}
.mail{
  background:var(--paper-deep);
  border:1px dashed var(--line);
  border-radius:2px;
  padding:18px 20px 18px 22px;
  cursor:pointer;
  position:relative;
  display:grid;
  grid-template-columns:1fr auto;
  gap:4px 16px;
  box-shadow:1px 2px 0 rgba(38,36,31,.05);
  transition:border-color .12s ease, transform .12s ease, box-shadow .12s ease;
}
.mail:hover{border-color:var(--ink);border-style:solid;transform:translateX(2px);box-shadow:2px 4px 0 rgba(38,36,31,.1)}
.mail::before{
  content:"";
  position:absolute;left:0;top:0;bottom:0;width:5px;
}
.mail.important::before{background:var(--stamp-red)}
.mail.normal::before{background:var(--stamp-ochre)}
.mail.low::before{background:var(--stamp-sage)}
.badges{
  grid-column:2;grid-row:1;
  display:flex;flex-direction:column;align-items:flex-end;gap:4px;
}
.mail .badge{
  font-family:var(--font-mono);
  font-size:.68rem;
  letter-spacing:.08em;
  padding:3px 8px;
  border:1px solid currentColor;
  border-radius:20px;
  white-space:nowrap;
}
.mail.important .badge{color:var(--stamp-red)}
.mail.normal .badge{color:var(--stamp-ochre)}
.mail.low .badge{color:var(--stamp-sage)}
.mail .call-badge{color:var(--pine)!important}
.mail .cat-badge{color:var(--ink-soft)!important;border-style:dashed}
.mail h3{
  grid-column:1;
  font-family:var(--font-display);
  font-weight:600;
  font-size:1.25rem;
  margin:2px 0 0;
}
.mail .from{
  grid-column:1;
  font-family:var(--font-mono);
  font-size:.75rem;
  color:var(--ink-soft);
  margin:0;
}
.mail p.snip{grid-column:1/-1;margin:6px 0 0;color:var(--ink-soft);font-size:.92rem}
.mail .due{
  grid-column:1/-1;
  font-family:var(--font-mono);
  font-size:.72rem;
  color:var(--pine);
  margin-top:6px;
}
.empty{color:var(--ink-soft);font-style:italic;padding:24px 0}

.schedule{display:grid;gap:26px}
.day-group h4{
  font-family:var(--font-mono);
  font-size:.8rem;
  letter-spacing:.06em;
  color:var(--pine);
  display:inline-block;
  border:1px solid var(--pine);
  border-radius:50px;
  padding:5px 14px;
  margin:0 0 12px;
}
.day-group .emails{gap:8px}
.day-group .mail h3{font-size:1.05rem}

.biz-groups{display:grid;gap:26px}
.biz-group h4{
  font-family:var(--font-mono);font-size:.8rem;letter-spacing:.06em;
  color:var(--pine);display:inline-block;border:1px solid var(--pine);
  border-radius:50px;padding:5px 14px;margin:0 0 12px;
}
.biz-group .emails{gap:8px}

.memo-board{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:26px 20px;
  padding-top:6px;
}
.memo-slip{
  --tilt:-1deg;
  background:linear-gradient(180deg,#fdf5f7,var(--memo-pink) 320%);
  border:1px solid #d9aab8;
  border-radius:1px;
  padding:18px 18px 16px;
  position:relative;
  cursor:pointer;
  transform:rotate(var(--tilt));
  box-shadow:3px 4px 0 rgba(38,36,31,.08);
  transition:transform .16s ease, box-shadow .16s ease;
}
.memo-slip:nth-child(4n+1){--tilt:-1.4deg}
.memo-slip:nth-child(4n+2){--tilt:.9deg}
.memo-slip:nth-child(4n+3){--tilt:-.4deg}
.memo-slip:nth-child(4n+4){--tilt:1.3deg}
.memo-slip:hover{transform:rotate(0deg) translateY(-3px);box-shadow:5px 7px 0 rgba(38,36,31,.14)}
.memo-tape{
  position:absolute;top:-9px;left:50%;width:46px;height:18px;
  transform:translateX(-50%) rotate(-2deg);
  background:rgba(255,255,255,.55);
  border:1px solid rgba(38,36,31,.08);
  box-shadow:0 1px 2px rgba(38,36,31,.1);
}
.memo-head{
  display:flex;align-items:center;gap:6px;margin-bottom:12px;
  color:var(--memo-ink);
}
.memo-icon{font-size:1rem}
.memo-title{
  font-family:var(--font-mono);font-size:.66rem;letter-spacing:.09em;
  text-transform:uppercase;font-weight:700;
}
.memo-fields{display:grid;grid-template-columns:auto 1fr;gap:3px 10px;margin:0 0 12px}
.memo-fields dt{margin:0;color:var(--memo-ink);font-size:.6rem}
.memo-fields dd{margin:0;font-size:.78rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.memo-msg{margin:0 0 8px;font-size:.88rem;color:var(--ink);line-height:1.5}
.memo-action{
  margin:10px 0 0;padding-top:8px;border-top:1px dashed #d9aab8;
  font-family:var(--font-mono);font-size:.7rem;color:var(--memo-ink);
}

.tone-btn.biz-tone{
  border-color:var(--pine);color:var(--pine);font-weight:700;
}
.tone-btn.biz-tone.active{background:var(--pine);border-color:var(--pine);color:var(--paper)}

dialog{
  width:min(640px,92vw);
  border:2px solid var(--ink);
  border-radius:2px;
  padding:30px 32px;
  background:var(--paper);
  box-shadow:10px 10px 0 rgba(38,36,31,.12);
  position:relative;
  overflow:auto;
  max-height:85vh;
  animation:dialogPop .4s ease .15s backwards;
}
@keyframes dialogPop{from{transform:scale(.94) translateY(6px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.dialog-flap{
  position:absolute;top:-2px;left:-2px;right:-2px;height:44px;
  background:var(--pine);
  clip-path:polygon(0 0,50% 100%,100% 0);
  transform-origin:top center;pointer-events:none;
  box-shadow:0 8px 16px rgba(0,0,0,.35);
  z-index:5;
  opacity:0;
}
.dialog-flap.flap-play{
  animation:flapOpen 1.1s cubic-bezier(.34,1.1,.5,1) forwards;
}
@keyframes flapOpen{
  0%{transform:rotateX(0deg) translateY(0);opacity:1}
  18%{transform:rotateX(0deg) translateY(0);opacity:1}
  70%{transform:rotateX(-110deg) translateY(-10px);opacity:1}
  100%{transform:rotateX(-170deg) translateY(-16px);opacity:0}
}
dialog::backdrop{background:rgba(38,36,31,.35)}
.close{
  float:right;background:none;border:0;
  font-size:1.5rem;color:var(--ink-soft);cursor:pointer;
  line-height:1;padding:2px 4px;
}
.meta{font-family:var(--font-mono);font-size:.75rem;color:var(--ink-soft);margin:0}
dialog h2{font-family:var(--font-display);font-size:1.7rem;margin:6px 0 14px}
.lede{color:var(--ink-soft);margin:0 0 6px}
dt{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.06em;color:var(--pine);text-transform:uppercase;margin-top:14px}
dd{margin:3px 0 0;color:var(--ink)}
hr{border:0;border-top:1px solid var(--line);margin:20px 0}
label{font-size:.85rem;color:var(--ink-soft)}
.hint{font-family:var(--font-mono);font-size:.7rem;color:var(--pine);margin:2px 0 12px}
.ideas-list{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:8px}
.ideas-list li{
  background:var(--paper-deep);border:1px solid var(--line);border-radius:2px;
  padding:10px 14px;font-size:.9rem;position:relative;padding-left:28px;
  cursor:pointer;transition:border-color .12s ease, transform .12s ease;
}
.ideas-list li:hover{border-color:var(--pine);transform:translateX(2px)}
.ideas-list li::before{content:"✎";position:absolute;left:10px;color:var(--pine)}
.ideas-list li.error{color:var(--stamp-red);padding-left:14px;cursor:default}
.ideas-list li.error:hover{border-color:var(--line);transform:none}
.ideas-list li.error::before{content:""}

.plan-steps{display:grid;gap:14px;margin-top:16px}
.plan-step{display:grid;grid-template-columns:32px 1fr;gap:12px}
.plan-num{
  width:32px;height:32px;border-radius:50%;background:var(--pine);color:var(--paper);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-size:.85rem;font-weight:700;flex-shrink:0;
}
.plan-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.plan-head h4{font-family:var(--font-display);font-size:1.02rem;margin:0}
.plan-time{font-family:var(--font-mono);font-size:.68rem;color:var(--pine);white-space:nowrap}
.plan-body p{margin:4px 0 0;color:var(--ink-soft);font-size:.9rem}

.plan-extra{margin-top:18px}
.plan-extra-title{
  font-family:var(--font-mono);font-size:.7rem;letter-spacing:.06em;
  color:var(--pine);text-transform:uppercase;margin:0 0 8px;
}
.chip-list{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--paper-deep);border:1px solid var(--line);border-radius:20px;
  padding:6px 12px;font-size:.82rem;color:var(--ink);text-decoration:none;
  transition:border-color .12s ease;
}
.chip:hover{border-color:var(--pine);color:var(--pine)}
.tones{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:4px}
.tone-btn{
  border:1px solid var(--line);background:var(--paper-deep);
  color:var(--ink-soft);font-family:var(--font-body);font-size:.82rem;font-weight:600;
  padding:8px 14px;border-radius:20px;cursor:pointer;transition:.12s ease;
}
.tone-btn:hover{border-color:var(--pine);color:var(--ink)}
.tone-btn.active{background:var(--pine);border-color:var(--pine);color:var(--paper)}
.draft-box{margin-top:14px;border:1px solid var(--line);border-radius:2px;padding:14px;background:#fff}
.cost-note{
  background:#fdf0e6;border:1px solid var(--stamp-ochre);border-radius:2px;
  padding:10px 12px;font-size:.82rem;color:var(--ink);margin:0 0 12px;
}
.cat-select{
  width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:2px;
  font-family:var(--font-body);font-size:.88rem;background:#fff;color:var(--ink);
}
.draft-box textarea{
  width:100%;border:1px solid var(--line);border-radius:2px;padding:10px 12px;
  font-family:var(--font-body);font-size:.92rem;color:var(--ink);resize:vertical;
}
.draft-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:10px}
.send-row{justify-content:space-between;align-items:center;flex-wrap:wrap;border-top:1px dashed var(--line);padding-top:12px;margin-top:12px}
.send-warning{margin:0;flex:1;min-width:200px}
.button.send{background:var(--stamp-red);border-color:var(--stamp-red);color:#fff}
.button.send:hover{background:#96382a}
.button.small{padding:8px 14px;font-size:.82rem}
.draft-status{font-family:var(--font-mono);font-size:.72rem;color:var(--pine);margin:8px 0 0;min-height:1em}
.ask{display:flex;gap:8px;margin-top:8px}
.ask input{
  flex:1;padding:11px 12px;border:1px solid var(--line);
  border-radius:2px;font-family:var(--font-body);background:#fff;
}
.ask input:focus,button:focus-visible,.button:focus-visible,.tab:focus-visible{
  outline:2px solid var(--pine);outline-offset:2px;
}
.answer{margin-top:14px;color:var(--ink);white-space:pre-wrap}

@media(max-width:640px){
  main{padding:36px 16px 70px}
  h1{font-size:2.4rem}
  .summary{grid-template-columns:1fr}
  .mail{grid-template-columns:1fr}
  .mail .badge{grid-column:1;grid-row:auto;justify-self:start}
  .memo-board{grid-template-columns:1fr;gap:22px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
